{
    "$schema": "../config/site.schema.json",
    "schemaVersion": 1,
    "site": {
        "name": "Fixture Site",
        "baseUrl": "https://docs.example.test",
        "basePath": "/",
        "hostname": "docs.example.test"
    },
    "organization": {
        "name": "fixture-org",
        "propertyName": "docs",
        "onboardValue": "true",
        "tokenEnvVar": "FIXTURE_DISCOVERY_TOKEN",
        "excludeRepositories": ["archived"]
    },
    "source": {
        "directory": "docs",
        "defaultBranchOnly": true
    },
    "render": {
        "concurrency": 2,
        "safeMode": "secure"
    },
    "output": {
        "directory": "build/site",
        "cacheDirectory": "build/cache",
        "reportPath": "build/report.json"
    }
}
