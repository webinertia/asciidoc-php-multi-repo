#!/usr/bin/env php
<?php

declare(strict_types=1);

use Webware\AsciidocPhp\MultiRepo\Cli\Application;
use Webware\AsciidocPhp\MultiRepo\Cli\ExitCode;
use Webware\AsciidocPhp\MultiRepo\Cli\Output;

// Two locations: a checkout of this package, and the vendor tree of a consumer that installed it.
$autoloaders = [
    __DIR__ . '/../vendor/autoload.php',
    __DIR__ . '/../../../autoload.php',
];

$autoloaded = false;

foreach ($autoloaders as $autoloader) {
    if (! is_file($autoloader)) {
        continue;
    }

    require $autoloader;
    $autoloaded = true;

    break;
}

if (! $autoloaded) {
    $stream = fopen('php://stderr', mode: 'wb');

    if (false !== $stream) {
        fwrite($stream, Application::NAME . ": unable to locate the Composer autoloader\n");
    }

    exit(ExitCode::InternalError->value);
}

$arguments = [];

if (isset($_SERVER['argv']) && is_array($_SERVER['argv'])) {
    foreach ($_SERVER['argv'] as $argument) {
        if (! is_string($argument)) {
            continue;
        }

        $arguments[] = $argument;
    }
}

$application = new Application(interactive: Output::stderrIsTty());

exit($application->run($arguments));
