{
    "name": "webware/asciidoc-php-multi-repo",
    "description": "Multi-repository documentation site builder for asciidoc-php: aggregates docs from many repositories into one static site",
    "type": "library",
    "license": "BSD-3-Clause",
    "keywords": [
        "asciidoc",
        "documentation",
        "static-site",
        "github-pages"
    ],
    "authors": [
        {
            "name": "Joey (aka Tyrsson) Smith",
            "email": "jsmith@webinertia.net",
            "role": "Developer"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.4.99"
        }
    },
    "require": {
        "php": "~8.4.0 || ~8.5.0",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "webware/asciidoc-php": "^0.1"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^13.0.0"
    },
    "autoload": {
        "psr-4": {
            "Webware\\AsciidocPhpMultiRepo\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Webware\\AsciidocPhpMultiRepo\\Test\\": "tests/"
        }
    },
    "bin": [
        "bin/asciidoc-php-multi-repo"
    ],
    "scripts": {
        "check-all": [
            "@sa",
            "@test"
        ],
        "test": "phpunit --colors=always",
        "sa": "phpstan analyse --memory-limit=512M"
    }
}
