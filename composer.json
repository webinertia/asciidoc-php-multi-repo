{
    "name": "webware/asciidoc-php-multi-repo",
    "description": "Multi-repository documentation site builder for asciidoc-php: aggregates docs from many repositories into one static site",
    "type": "library",
    "license": "BSD-3-Clause",
    "keywords": [
        "asciidoc",
        "documentation",
        "static-site",
        "github-pages"
    ],
    "authors": [
        {
            "name": "Joey (aka Tyrsson) Smith",
            "email": "jsmith@webinertia.net",
            "role": "Developer"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.4.99"
        },
        "allow-plugins": {
            "infection/extension-installer": true
        }
    },
    "require": {
        "php": "~8.4.0 || ~8.5.0",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "webware/asciidoc-php": "^0.1"
    },
    "require-dev": {
        "infection/infection": "^0.35.0",
        "phpbench/phpbench": "^1.7",
        "phpunit/phpunit": "^13.0.0",
        "roave/backward-compatibility-check": "^8.21.0",
        "roave/security-advisories": "dev-master",
        "webware/webware-tools": "^1.0.0-rc.8"
    },
    "autoload": {
        "psr-4": {
            "Webware\\AsciidocPhpMultiRepo\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "WebwareTest\\AsciidocPhpMultiRepo\\": "test/unit/",
            "WebwareTestIntegration\\AsciidocPhpMultiRepo\\": "test/integration/"
        }
    },
    "bin": [
        "bin/asciidoc-php-multi-repo"
    ],
    "scripts": {
        "test": "phpunit --no-coverage --colors=always",
        "test-coverage": "phpunit --colors=always --coverage-clover clover.xml --coverage-text",
        "test-integration": "phpunit --no-coverage --colors=always --testsuite \"integration test\"",
        "mutation-test": "infection",
        "test-all": [
            "@test",
            "@test-integration",
            "@mutation-test"
        ]
    }
}
