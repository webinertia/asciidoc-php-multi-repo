{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://raw.githubusercontent.com/webinertia/asciidoc-php-multi-repo/main/config/site.schema.json",
    "title": "Multi-Repo Documentation Site Configuration",
    "description": "The single configuration document consumed by asciidoc-php-multi-repo. All site-specific values live here, never in the package.",
    "type": "object",
    "required": ["schemaVersion", "site", "organization"],
    "additionalProperties": false,
    "properties": {
        "$schema": { "type": "string" },
        "schemaVersion": { "type": "integer", "const": 1 },
        "site": {
            "type": "object",
            "required": ["name", "baseUrl"],
            "additionalProperties": false,
            "properties": {
                "name": { "type": "string", "minLength": 1 },
                "baseUrl": {
                    "type": "string",
                    "pattern": "^https?://[^\\s]+$"
                },
                "basePath": {
                    "type": "string",
                    "pattern": "^(/|/[^\\s]*/)$",
                    "default": "/"
                },
                "hostname": { "type": "string", "minLength": 1 },
                "defaultVersionLabel": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]*$",
                    "default": "latest"
                }
            }
        },
        "organization": {
            "type": "object",
            "required": ["name", "propertyName"],
            "additionalProperties": false,
            "properties": {
                "name": { "type": "string", "minLength": 1 },
                "propertyName": { "type": "string", "minLength": 1 },
                "onboardValue": { "type": "string", "default": "true" },
                "tokenEnvVar": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
                "excludeRepositories": {
                    "type": "array",
                    "items": { "type": "string", "minLength": 1 },
                    "default": []
                }
            }
        },
        "source": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "directory": { "type": "string", "minLength": 1, "default": "docs" },
                "defaultBranchOnly": { "type": "boolean", "default": true },
                "entryCandidates": {
                    "type": "array",
                    "minItems": 1,
                    "items": { "type": "string", "minLength": 1 },
                    "default": ["index.adoc", "README.adoc"]
                },
                "extensions": {
                    "type": "array",
                    "minItems": 1,
                    "items": { "type": "string", "pattern": "^\\.[a-z0-9]+$" },
                    "default": [".adoc", ".asciidoc"]
                },
                "versionPattern": {
                    "type": "string",
                    "minLength": 1,
                    "default": "^v[1-9][0-9]*$"
                },
                "excludePatterns": {
                    "type": "array",
                    "items": { "type": "string", "minLength": 1 },
                    "default": ["**/_*.adoc", "**/_*.asciidoc"]
                }
            }
        },
        "render": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "tocLevels": {
                    "type": "array",
                    "minItems": 1,
                    "items": { "type": "integer", "minimum": 1, "maximum": 6 },
                    "default": [2, 3]
                },
                "safeMode": {
                    "type": "string",
                    "enum": ["unsafe", "safe", "server", "secure"],
                    "default": "safe"
                },
                "concurrency": { "type": "integer", "minimum": 1, "maximum": 32, "default": 4 },
                "searchExtractLimit": { "type": "integer", "minimum": 200, "maximum": 20000, "default": 2000 },
                "syntaxHighlighting": { "type": "boolean", "default": false }
            }
        },
        "theme": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "name": { "type": "string", "minLength": 1, "default": "webware" },
                "defaultAccent": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$", "default": "#7e5ae0" },
                "colorMode": {
                    "type": "string",
                    "enum": ["system", "light", "dark"],
                    "default": "system"
                },
                "defaultColorMode": {
                    "type": "string",
                    "enum": ["light", "dark"],
                    "default": "dark"
                }
            }
        },
        "output": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "directory": { "type": "string", "minLength": 1, "default": "build/site" },
                "cacheDirectory": { "type": "string", "minLength": 1, "default": ".cache/multi-repo" },
                "reportPath": { "type": "string", "minLength": 1, "default": "build/report.json" }
            }
        },
        "projects": {
            "type": "object",
            "additionalProperties": { "$ref": "#/$defs/projectOverride" }
        }
    },
    "$defs": {
        "projectOverride": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
                "title": { "type": "string", "minLength": 1 },
                "description": { "type": "string", "minLength": 1 },
                "accent": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
                "order": { "type": "integer" }
            }
        }
    }
}
